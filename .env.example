# =============================================================================
# TSE Stock Screener — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# === API / security ===
# Runtime mode: set to production on Render.
TSE_ENVIRONMENT=development
TSE_ENABLE_DOCS=true
# Optional comma-separated host allowlist. Leave empty for local development.
TSE_ALLOWED_HOSTS=
# JWT signing secret. Generate with: openssl rand -hex 32
TSE_JWT_SECRET=
# Comma-separated browser origins allowed by FastAPI. Leave empty for a
# same-origin production deployment; do not use "*" with credentials.
TSE_CORS_ORIGINS=http://localhost:5173

# Only trust X-Forwarded-For from these reverse-proxy CIDRs (empty = do not
# trust the header). Render users should set this to the platform proxy range.
TSE_TRUSTED_PROXY_CIDRS=
TSE_FORCE_HTTPS_HEADERS=false

# Per-process API/provider request limits (single-worker deployment).
TSE_PUBLIC_RATE_LIMIT=120
TSE_MAX_REQUEST_BYTES=2097152
TSE_MAX_REQUEST_CHUNKS=4096
TSE_API_RATE_LIMIT=120
TSE_PROVIDER_RATE_LIMIT=30
TSE_LOGIN_RATE_LIMIT=30
TSE_ALERT_RATE_LIMIT=10
TSE_PROVIDER_MAX_CONCURRENCY=8
TSE_PROVIDER_MIN_INTERVAL_MS=25
TSE_ALERT_MAX_CONCURRENCY=2
TSE_CACHE_MAX_FILES=2000
TSE_CACHE_MAX_BYTES=536870912
TSE_FUND_CACHE_MAX_ENTRIES=512
TSE_AUTO_SCAN_SCHEDULER=true

# Optional persistent data directory (recommended in production).
TSE_DATA_DIR=./data

# Optional one-time ownership policy for the pre-migration global portfolio.
# Leave blank unless an administrator has chosen the destination user ID.
TSE_LEGACY_PORTFOLIO_USER_ID=

# === Bootstrap admin (auto-created on first startup) ===
# On first launch, if the users table is empty AND both vars are set,
# the admin account is created automatically. The SQLite DB itself is
# created on first launch (gitignored under data/). After that, the
# login form on the dashboard accepts this username/password.
#
# Password must be at least 8 characters (12+ in production).
TSE_ADMIN_USER=admin
TSE_ADMIN_PASSWORD=

# === Telegram (for signal alerts) ===
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Use @userinfobot or @getmyid_bot to find your chat ID
TELEGRAM_CHAT_ID=

# === Slack (for signal alerts) ===
# Create an Incoming Webhook in Slack API > Apps > Incoming Webhooks
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# === Optional: Broker APIs (future use) ===
# JQUANTS_EMAIL=
# JQUANTS_PASSWORD=
# RAKUTEN_APP_KEY=
# RAKUTEN_SECRET_KEY=
